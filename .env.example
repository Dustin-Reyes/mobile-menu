# ============================================================
# Transpiled Web Template - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# VITE_ prefix = exposed to browser (public, no secrets)
# No prefix    = server-side only (Netlify Functions, never public)
# ============================================================

# --- Frontend (browser-safe) ---
VITE_SENTRY_DSN=
VITE_APP_ENV=development

# --- Firebase CMS (Optional) ---
# Enable Firebase CMS functionality
VITE_CMS_ENABLED=false

# Firebase Configuration (get from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Backend (Netlify Functions only) ---
SENTRY_DSN=
# ALLOWED_ORIGIN=https://yourdomain.com

# Firebase Admin SDK (for user-management Netlify function)
# Generate: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Encode:   base64 -i service-account.json | tr -d '\n'
# NEVER commit the raw JSON or this value to source control.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Cloudflare R2 (Media Upload) ---
# Used by Netlify Functions for presigned PUT URLs and image processing.
# Create an R2 bucket in the Cloudflare Dashboard, then generate an API token
# with Object Read & Write permissions.
#
# Account ID:  Cloudflare Dashboard → right sidebar
# Access keys: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Bucket name: the name you gave your R2 bucket
# Public URL:  R2 bucket → Settings → Public Access (or your custom domain)
#              e.g. https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Endpoint:    https://<account-id>.r2.cloudflarestorage.com
#              (used by the presigner — must match CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional key prefix for all R2 objects (e.g. "production/images/my-site/").
# Must end with "/" if set. Leave empty for no prefix.
R2_KEY_PREFIX=
