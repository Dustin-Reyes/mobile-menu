{
  "name": "transpiled-web-template",
  "version": "0.2.5",
  "private": true,
  "description": "Transpiled web template — Vite + React starter with full toolchain",
  "license": "MIT",
  "repository": "",
  "packageManager": "yarn@4.8.1",
  "engines": {
    "node": ">=23.10.0"
  },
  "scripts": {
    "dev": "./dev.sh",
    "dev:logs": "concurrently -k -n \"vite\" -c \"green\" \"vite --host --port 5173\"",
    "build": "vite build && yarn sentry:sourcemaps || true",
    "preview": "vite preview --port 5173 --host",
    "setup": "node scripts/setup.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,mjs}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs}\" --ignore-path .gitignore",
    "clean": "rm -rf dist && rm -rf .vite",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "sentry:sourcemaps": "(sentry-cli sourcemaps inject --org transpiled --project transpiled-web-template ./dist && sentry-cli sourcemaps upload --org transpiled --project transpiled-web-template ./dist) || echo 'Warning: Sentry sourcemap upload failed, continuing build...'",
    "seed": "node scripts/seed-content.mjs",
    "translate": "node scripts/translate-content.mjs",
    "setup-prereqs": "./scripts/check-prerequisites.sh",
    "seo:test": "node scripts/test-seo.js",
    "build:audit": "node scripts/audit-build.js",
    "start": "./dev.sh",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:first": "standard-version --first-release"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/node": "^10.56.0",
    "@sentry/react": "^9.12.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.16",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.575.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.6",
    "react-router-dom": "6.27.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@clack/prompts": "^0.9.0",
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.0",
    "@sentry/cli": "^2.43.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "4.5.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "concurrently": "^9.1.2",
    "eslint": "9.20.1",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-cli": "30.0.0-beta.3",
    "jest-environment-jsdom": "^29.7.0",
    "netlify-cli": "^17.0.0",
    "prettier": "^3.5.3",
    "qrcode-terminal": "^0.12.0",
    "standard-version": "^9.5.0",
    "vite": "6.4.3",
    "vite-plugin-svgr": "^4.3.0"
  }
}
